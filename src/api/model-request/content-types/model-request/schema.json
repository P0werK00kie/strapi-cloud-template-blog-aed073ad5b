{
  "kind": "collectionType",
  "collectionName": "model_requests",
  "info": {
    "singularName": "model-request",
    "pluralName": "model-requests",
    "displayName": "Model Request",
    "description": "Bring It to Your County form submissions from /walton-model. Written server side with an API token; no public access."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "email": {
      "type": "email",
      "required": true,
      "maxLength": 200
    },
    "county": {
      "type": "string",
      "required": true,
      "maxLength": 80
    },
    "clubStatus": {
      "type": "enumeration",
      "enum": [
        "active",
        "inactive",
        "none"
      ],
      "required": true
    },
    "memberCount": {
      "type": "integer",
      "min": 0
    },
    "notes": {
      "type": "text",
      "maxLength": 2000
    },
    "submittedAt": {
      "type": "datetime"
    }
  }
}
