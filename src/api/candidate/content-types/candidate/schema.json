{
  "kind": "collectionType",
  "collectionName": "candidates",
  "info": {
    "singularName": "candidate",
    "pluralName": "candidates",
    "displayName": "Candidate",
    "description": "WCYR website candidates for /2026candidates"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "minLength": 2,
      "maxLength": 120
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "office": {
      "type": "string",
      "maxLength": 200
    },
    "category": {
      "type": "enumeration",
      "enum": ["Federal", "State", "Local"],
      "default": "State"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "photos": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"]
    },
    "bio": {
      "type": "blocks",
      "required": false
    },
    "issues": {
      "type": "component",
      "repeatable": true,
      "component": "candidate.issue"
    },
    "talkingPoints": {
      "type": "component",
      "repeatable": true,
      "component": "candidates.talking-point"
    },
    "hasBioPage": {
      "type": "boolean",
      "default": true,
      "required": true
    },
    "contactUrl": {
      "type": "string",
      "maxLength": 500,
      "regex": "^https?://.+"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    },
    "metaTitle": {
      "type": "string",
      "maxLength": 60
    },
    "metaDescription": {
      "type": "text",
      "maxLength": 160
    },
    "metaImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
